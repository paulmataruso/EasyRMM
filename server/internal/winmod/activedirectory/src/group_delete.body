try {
    Import-DirectoryModule
    $c = Get-Context $true
    $common = $c.Common
    $set = Get-ProtectedSet $c
    $g = Get-TargetGroup ([string]$p.id) $c
    Assert-Writable $g $set $c ''
    if ((Get-Prop $g 'ProtectedFromAccidentalDeletion') -eq $true) { Stop-With 'not_enabled' 'This group is protected from accidental deletion. Clear that in the directory tools first; this console does not.' }
    Remove-ADGroup -Identity $g -Confirm:$false @common
    Write-Result $true ([ordered]@{ done = $true }) $null $null
} catch {
    Stop-ForError $_
}
