try {
    Import-DirectoryModule
    $c = Get-Context $false
    $dom = [string]$c.DomainSid
    $for = [string]$c.ForestSid
    # Tier 1 holds the domain; tier 2 are the other groups of Microsoft's protected list.
    $roots = @(
        @((Join-Text $dom '-512'), $false, 1), @((Join-Text $for '-519'), $true, 1), @((Join-Text $for '-518'), $true, 1), @('S-1-5-32-544', $false, 1),
        @('S-1-5-32-548', $false, 2), @('S-1-5-32-549', $false, 2), @('S-1-5-32-550', $false, 2), @('S-1-5-32-551', $false, 2),
        @('S-1-5-32-552', $false, 2), @((Join-Text $dom '-520'), $false, 2)
    )
    $groups = @()
    foreach ($root in $roots) {
        $g = Find-Group ([string]$root[0]) ([bool]$root[1]) $false $c
        if ($null -eq $g) { continue }
        $members = @()
        $total = 0
        foreach ($dn in (Get-List $g 'member')) {
            $total++
            if ($members.Count -ge 100) { continue }
            $srv = $c.Server
            if (-not (Test-UnderDn ([string]$dn) ([string]$c.DomainDn))) { $srv = Join-Text $c.Server ':3268' }
            $m = Get-ADObject -Identity $dn -Properties objectSid, objectClass -Server $srv
            $kind = 'other'
            switch ([string]$m.objectClass) { 'user' { $kind = 'user' } 'computer' { $kind = 'computer' } 'group' { $kind = 'group' } 'foreignSecurityPrincipal' { $kind = 'foreign' } }
            $members += [ordered]@{ id = [string]$m.objectSid.Value; name = [string]$m.Name; kind = $kind }
        }
        $groups += [ordered]@{
            id = [string]$g.SID.Value; name = [string]$g.Name; tier = [int]$root[2]; total = $total
            changedAt = Get-UtcText (Get-Prop $g 'whenChanged'); members = @($members)
        }
    }
    Write-Result $true ([ordered]@{ groups = @($groups) }) $null $null
} catch {
    Stop-ForError $_
}
