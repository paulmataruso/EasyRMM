try {
    Import-DirectoryModule
    $c = Get-Context $true
    $common = $c.Common
    $set = Get-ProtectedSet $c
    $u = Get-TargetUser ([string]$p.id) $c
    Assert-Writable $u $set $c ([string](Get-Prop $p 'serviceConfirm'))
    Unlock-ADAccount -Identity $u @common
    Write-Result $true ([ordered]@{ done = $true }) $null $null
} catch {
    Stop-ForError $_
}
