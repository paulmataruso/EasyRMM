try {
    Import-GroupPolicyModule
    $c = Get-Context
    $common = $c.Common
    Assert-NotDefault ([string]$p.id) 'unlinked'
    Assert-InDomain ([string]$p.target) $c
    $g = Get-GPO -Guid ([string]$p.id) @common
    if (-not ([string]$g.DisplayName).Equals([string]$p.name, 'OrdinalIgnoreCase')) { Stop-With 'name_mismatch' 'The name typed is not this GPO''s name.' }
    Assert-Versions $g
    $vb = Get-Versions $g
    $backup = Save-GpoBackup $g 'link_remove' $c
    [void](Remove-GPLink -Guid ([string]$p.id) -Target ([string]$p.target) @common)
    Write-Changed (Format-Text 'Removed the link of {0} to {1}.' ([string]$g.DisplayName) ([string]$p.target)) ([ordered]@{ target = [string]$p.target }) ([ordered]@{}) $g $backup $vb (Get-Versions (Get-GPO -Guid ([string]$p.id) @common))
} catch {
    Stop-ForError $_
}
