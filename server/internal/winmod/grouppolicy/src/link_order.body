try {
    Import-GroupPolicyModule
    $c = Get-Context
    $common = $c.Common
    Assert-InDomain ([string]$p.target) $c
    $g = Get-GPO -Guid ([string]$p.id) @common
    Assert-Versions $g
    $inh = Get-GPInheritance -Target ([string]$p.target) @common
    $cur = $null
    foreach ($l in @($inh.GpoLinks)) { if (([string]$l.GpoId).ToLowerInvariant() -eq ([string]$p.id)) { $cur = $l } }
    if ($null -eq $cur) { Stop-With 'not_found' 'That GPO is not linked there.' }
    $vb = Get-Versions $g
    $backup = Save-GpoBackup $g 'link_order' $c
    $args2 = @{ Guid = [string]$p.id; Target = [string]$p.target }
    $args2['Order'] = [int]$p.order
    $new = Set-GPLink @args2 @common
    $after = Get-GPO -Guid ([string]$p.id) @common
    Write-Changed (Format-Text 'Changed the order of the link of {0} to {1}.' ([string]$g.DisplayName) ([string]$p.target)) ([ordered]@{ order = [string]$cur.Order }) ([ordered]@{ order = [string]$new.Order }) $after $backup $vb (Get-Versions $after)
} catch {
    Stop-ForError $_
}
