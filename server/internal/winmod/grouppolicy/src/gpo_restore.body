try {
    Import-GroupPolicyModule
    $c = Get-Context
    $common = $c.Common
    $g = $null
    try { $g = Get-GPO -Guid ([string]$p.id) @common } catch { $g = $null }
    if ($null -ne $g) {
        if (-not ([string]$g.DisplayName).Equals([string]$p.name, 'OrdinalIgnoreCase')) { Stop-With 'name_mismatch' 'The name typed is not this GPO''s name.' }
        Assert-Versions $g
    }
    $base = Get-StagingBase
    $dir = [System.IO.Path]::Combine($base, (Join-Text 'restore-' ([string]$p.backupId)))
    $text = ''
    for ($i = 0; $i -lt [int]$p.parts; $i++) {
        $file = [System.IO.Path]::Combine($dir, (Join-Text 'part-' ([string]$i)))
        if (-not (Test-Path -LiteralPath $file)) { Stop-With 'chunk_missing' 'The backup did not arrive in full. Try the restore again.' }
        $text = Join-Text $text ([System.IO.File]::ReadAllText($file))
    }
    $bytes = [System.Convert]::FromBase64String($text)
    if ((Get-HexHash $bytes) -ne [string]$p.zipSha256) { Stop-With 'hash_mismatch' 'The backup that arrived is not the one the server keeps. Nothing was restored.' }
    $vb = $null
    $backup = $null
    if ($null -ne $g) {
        $vb = Get-Versions $g
        $backup = Save-GpoBackup $g 'gpo_restore' $c
    }
    $files = [System.IO.Path]::Combine($dir, 'files')
    $zip = [System.IO.Path]::Combine($dir, 'backup.zip')
    [System.IO.File]::WriteAllBytes($zip, $bytes)
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    [System.IO.Compression.ZipFile]::ExtractToDirectory($zip, $files)
    $done = Restore-GPO -BackupId ([string]$p.backupId) -Path $files @common
    Remove-Item -LiteralPath $dir -Recurse -Force
    $now = Get-GPO -Guid ([string]$done.Id) @common
    $beforeName = ''
    if ($null -ne $g) { $beforeName = [string]$g.DisplayName }
    Write-Changed (Format-Text 'Restored the GPO {0} from a backup.' ([string]$now.DisplayName) '') ([ordered]@{ name = $beforeName }) ([ordered]@{ name = [string]$now.DisplayName; id = ([string]$now.Id).ToLowerInvariant() }) $now $backup $vb (Get-Versions $now)
} catch {
    Stop-ForError $_
}
