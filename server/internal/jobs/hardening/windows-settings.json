{
  "version": 1,
  "settings": [
    {"id": "accounts-min-length", "module": "accounts", "what": "Passwords of at least 14 characters", "kind": "secedit", "key": "MinimumPasswordLength", "want": "min", "data": 14},
    {"id": "accounts-complexity", "module": "accounts", "what": "Password complexity on", "kind": "secedit", "key": "PasswordComplexity", "want": "eq", "data": 1},
    {"id": "accounts-history", "module": "accounts", "what": "24 passwords remembered", "kind": "secedit", "key": "PasswordHistorySize", "want": "min", "data": 24},
    {"id": "accounts-reversible", "module": "accounts", "what": "No reversible encryption of passwords", "kind": "secedit", "key": "ClearTextPassword", "want": "eq", "data": 0},
    {"id": "accounts-lockout-threshold", "module": "accounts", "what": "Lockout after 10 failed sign-ins", "kind": "secedit", "key": "LockoutBadCount", "want": "range", "data": 1, "max": 10, "cite": "differs"},
    {"id": "accounts-lockout-duration", "module": "accounts", "what": "Locked out for at least 15 minutes", "kind": "secedit", "key": "LockoutDuration", "want": "min", "data": 15, "orEq": -1},
    {"id": "accounts-lockout-reset", "module": "accounts", "what": "Failed sign-ins counted for at least 15 minutes", "kind": "secedit", "key": "ResetLockoutCount", "want": "min", "data": 15},
    {"id": "accounts-guest", "module": "accounts", "what": "The Guest account disabled", "kind": "secedit", "key": "EnableGuestAccount", "want": "eq", "data": 0},
    {"id": "accounts-blank-passwords", "module": "accounts", "what": "Blank passwords only at the console", "kind": "registry", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "LimitBlankPasswordUse", "want": "eq", "data": 1, "absent": "in_place", "csp": "LocalPoliciesSecurityOptions/Accounts_LimitLocalAccountUseOfBlankPasswordsToConsoleLogonOnly"},
    {"id": "accounts-max-age", "module": "accounts", "what": "Maximum password age (not set: NIST SP 800-63B)", "kind": "secedit", "key": "MaximumPasswordAge", "cite": "not_set"},
    {"id": "accounts-min-age", "module": "accounts", "what": "Minimum password age (not set)", "kind": "secedit", "key": "MinimumPasswordAge", "cite": "not_set"},

    {"id": "firewall-domain-enabled", "module": "firewall", "what": "Domain profile on", "kind": "firewall", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\DomainProfile", "name": "EnableFirewall", "profile": "Domain", "property": "Enabled", "want": "eq", "data": "True"},
