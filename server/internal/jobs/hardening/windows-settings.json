    {"id": "smb-server-smb1", "module": "smb", "what": "The SMB server does not speak SMB1", "kind": "smb", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters", "name": "SMB1", "side": "server", "property": "EnableSMB1Protocol", "want": "eq", "data": false, "csp": "MSSecurityGuide/ConfigureSMBV1Server"},
