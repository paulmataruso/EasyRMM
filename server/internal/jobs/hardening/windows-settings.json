    {"id": "rdp-encryption", "module": "rdp", "what": "Client connection encryption level High", "kind": "custom", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Terminal Services", "name": "MinEncryptionLevel", "csp": "RemoteDesktopServices/ClientConnectionEncryptionLevel"},
