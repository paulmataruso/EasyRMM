    {"id": "name-resolution-llmnr", "module": "name-resolution", "what": "LLMNR off", "kind": "registry", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\DNSClient", "name": "EnableMulticast", "want": "eq", "data": 0, "csp": "ADMX_DnsClient/Turn_Off_Multicast"},
    {"id": "name-resolution-netbios-release", "module": "name-resolution", "what": "NetBIOS ignores name release requests except from WINS servers", "kind": "registry", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\NetBT\\Parameters", "name": "NoNameReleaseOnDemand", "want": "eq", "data": 1, "csp": "MSSLegacy/AllowTheComputerToIgnoreNetBIOSNameReleaseRequestsExceptFromWINSServers"},
