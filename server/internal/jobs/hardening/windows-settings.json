    {"id": "smb-signing-client-required", "module": "smb-signing", "what": "The SMB client always signs", "kind": "smb", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters", "name": "RequireSecuritySignature", "side": "client", "property": "RequireSecuritySignature", "want": "eq", "data": true, "csp": "LocalPoliciesSecurityOptions/MicrosoftNetworkClient_DigitallySignCommunicationsAlways"},
