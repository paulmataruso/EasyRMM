    {"id": "firewall-domain-log-dropped", "module": "firewall", "what": "Domain profile logs dropped packets", "kind": "firewall", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\DomainProfile\\Logging", "name": "LogDroppedPackets", "profile": "Domain", "property": "LogBlocked", "want": "eq", "data": "True"},
    {"id": "firewall-domain-log-size", "module": "firewall", "what": "Domain profile's log at least 16,384 KB", "kind": "firewall", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\DomainProfile\\Logging", "name": "LogFileSize", "profile": "Domain", "property": "LogMaxSizeKilobytes", "want": "min", "data": 16384},
    {"id": "firewall-private-enabled", "module": "firewall", "what": "Private profile on", "kind": "firewall", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PrivateProfile", "name": "EnableFirewall", "profile": "Private", "property": "Enabled", "want": "eq", "data": "True"},
    {"id": "firewall-private-inbound", "module": "firewall", "what": "Private profile blocks inbound connections without a rule", "kind": "firewall", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PrivateProfile", "name": "DefaultInboundAction", "profile": "Private", "property": "DefaultInboundAction", "want": "eq", "data": "Block"},
    {"id": "firewall-private-log-dropped", "module": "firewall", "what": "Private profile logs dropped packets", "kind": "firewall", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PrivateProfile\\Logging", "name": "LogDroppedPackets", "profile": "Private", "property": "LogBlocked", "want": "eq", "data": "True"},
    {"id": "firewall-private-log-size", "module": "firewall", "what": "Private profile's log at least 16,384 KB", "kind": "firewall", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PrivateProfile\\Logging", "name": "LogFileSize", "profile": "Private", "property": "LogMaxSizeKilobytes", "want": "min", "data": 16384},
    {"id": "firewall-public-enabled", "module": "firewall", "what": "Public profile on", "kind": "firewall", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PublicProfile", "name": "EnableFirewall", "profile": "Public", "property": "Enabled", "want": "eq", "data": "True"},
    {"id": "firewall-public-inbound", "module": "firewall", "what": "Public profile blocks inbound connections without a rule", "kind": "firewall", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PublicProfile", "name": "DefaultInboundAction", "profile": "Public", "property": "DefaultInboundAction", "want": "eq", "data": "Block"},
    {"id": "firewall-public-log-dropped", "module": "firewall", "what": "Public profile logs dropped packets", "kind": "firewall", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PublicProfile\\Logging", "name": "LogDroppedPackets", "profile": "Public", "property": "LogBlocked", "want": "eq", "data": "True"},
    {"id": "firewall-public-log-size", "module": "firewall", "what": "Public profile's log at least 16,384 KB", "kind": "firewall", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PublicProfile\\Logging", "name": "LogFileSize", "profile": "Public", "property": "LogMaxSizeKilobytes", "want": "min", "data": 16384},

    {"id": "defender-realtime", "module": "defender", "what": "Real-time protection on", "kind": "defender", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Real-Time Protection", "name": "DisableRealtimeMonitoring", "property": "DisableRealtimeMonitoring", "want": "eq", "data": "False", "tamper": true, "csp": "Defender/AllowRealtimeMonitoring"},
    {"id": "defender-behavior", "module": "defender", "what": "Behaviour monitoring on", "kind": "defender", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Real-Time Protection", "name": "DisableBehaviorMonitoring", "property": "DisableBehaviorMonitoring", "want": "eq", "data": "False", "tamper": true, "csp": "Defender/AllowBehaviorMonitoring"},
    {"id": "defender-cloud", "module": "defender", "what": "Cloud-delivered protection on", "kind": "defender", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Spynet", "name": "SpynetReporting", "property": "MAPSReporting", "want": "min", "data": 1, "tamper": true, "csp": "Defender/AllowCloudProtection"},
    {"id": "defender-pua", "module": "defender", "what": "Potentially unwanted applications blocked", "kind": "defender", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows Defender", "name": "PUAProtection", "property": "PUAProtection", "want": "eq", "data": 1, "csp": "Defender/PUAProtection"},
    {"id": "defender-network-protection", "module": "defender", "what": "Network protection blocks", "kind": "defender", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Windows Defender Exploit Guard\\Network Protection", "name": "EnableNetworkProtection", "property": "EnableNetworkProtection", "want": "eq", "data": 1, "only": {"client": true}, "csp": "Defender/EnableNetworkProtection"},
    {"id": "defender-smartscreen", "module": "defender", "what": "SmartScreen for Explorer on", "kind": "smartscreen", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "EnableSmartScreen", "csp": "SmartScreen/EnableSmartScreenInShell"},
    {"id": "defender-smartscreen-level", "module": "defender", "what": "SmartScreen warns (Block with smartscreen-block)", "kind": "smartscreen", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "ShellSmartScreenLevel", "want": "in", "data": ["Warn", "Block"], "option": "smartscreen-block", "optionData": "Block", "csp": "SmartScreen/PreventOverrideForFilesInShell", "cite": "differs"},
    {"id": "defender-cloud-block-level", "module": "defender", "what": "Cloud protection level High (cloud-block-high)", "kind": "defender", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\MpEngine", "name": "MpCloudBlockLevel", "property": "CloudBlockLevel", "want": "min", "data": 2, "option": "cloud-block-high", "csp": "Defender/CloudBlockLevel", "cite": "not_set"},
    {"id": "defender-signature-age", "module": "defender", "what": "Signatures no more than 7 days old", "kind": "custom"},
    {"id": "defender-last-scan", "module": "defender", "what": "A scan finished in the last 7 days", "kind": "custom"},

