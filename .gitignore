# Build output
/bin/
/dist/
/build/
*.exe
*.msi
*.deb
*.rpm
*.test
*.out
coverage*.txt
coverage*.html

# Go
/vendor/
go.work
go.work.sum

# Node / web
node_modules/
/web/dist/
/web/coverage/
/web/.vite/
*.tsbuildinfo
/tests/e2e/test-results/
/tests/e2e/playwright-report/
/tests/e2e/.auth/

# Embedded web assets are produced by the build
/server/internal/webui/dist/*
!/server/internal/webui/dist/.gitkeep

# Secrets and local configuration — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
# ...except the Go package that seals secrets: it holds code, not secrets.
!/server/internal/secrets/

# Runtime data (bind mounts)
/data/

# EasyPatch's machine-local files: its configuration, database password,
# release signing key and runtime data. easypatch/.gitignore ignores them too;
# they are listed here as well so that an edit there can never expose them.
/easypatch/.env
/easypatch/secrets/
/easypatch/local/
/easypatch/data/
/easypatch/backups/
/easypatch/artifacts/

# Claude Code / Impeccable local state
.claude/settings.local.json
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook-*.log

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Impeccable engine binary (downloaded by the launcher / installer; ~23 MB)
/.claude/skills/impeccable/scripts/bin/
/web/e2e/.run/
/web/e2e/.results/
/web/e2e/.report/
/web/screenshots/.results/
/web/e2e-sign-in/.results/
/web/e2e-sign-in/.report/
