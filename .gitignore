# Build output
/bin/
/dist/
/build/
*.exe
*.msi
*.deb
*.rpm
*.test
*.out
coverage*.txt
coverage*.html

# Go
/vendor/
go.work
go.work.sum

# Node / web
node_modules/
/web/dist/
/web/coverage/
/web/.vite/
/tests/e2e/test-results/
/tests/e2e/playwright-report/
/tests/e2e/.auth/

# Embedded web assets are produced by the build
/server/internal/webui/dist/*
!/server/internal/webui/dist/.gitkeep

# Secrets and local configuration — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Runtime data (bind mounts)
/data/

# Claude Code / Impeccable local state
.claude/settings.local.json
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook-*.log

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Impeccable engine binary (downloaded by the launcher / installer; ~23 MB)
/.claude/skills/impeccable/scripts/bin/
/web/e2e/.run/
/web/e2e/.results/
/web/e2e/.report/
