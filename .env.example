# ═══════════════════════════════════════════════════════════════
# EasyRMM Environment Configuration
# Copy to .env and fill in required values.
# ═══════════════════════════════════════════════════════════════

# ── Domain & TLS ─────────────────────────────────────────────
# Public domain name — Caddy obtains a Let's Encrypt certificate automatically.
EASYRM_DOMAIN=rmm.example.com
ACME_EMAIL=admin@example.com

# ── Database ─────────────────────────────────────────────────
EASYRM_DB_NAME=easyrm
EASYRM_DB_USER=easyrm
EASYRM_DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── Security ─────────────────────────────────────────────────
# 32+ character random string for CSRF token signing.
# Generate with: openssl rand -hex 32
EASYRM_CSRF_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND

# ── Default Admin ────────────────────────────────────────────
# Created on first startup if no admin exists.
EASYRM_ADMIN_EMAIL=admin@example.com
EASYRM_ADMIN_PASSWORD=CHANGE_ME_AFTER_FIRST_LOGIN

# ── MeshCentral ──────────────────────────────────────────────
EASYRM_MESH_ADMIN_USER=easyrmadmin
EASYRM_MESH_ADMIN_PASSWORD=CHANGE_ME_MESHCENTRAL_ADMIN_PASSWORD
# Login token key for iframe embedding.
# Generate with: openssl rand -hex 32
EASYRM_MESH_LOGIN_TOKEN_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND

# ── EasyPatch Integration (optional) ────────────────────────
EASYRM_EASYPATCH_ENABLED=false
EASYRM_EASYPATCH_URL=
EASYRM_EASYPATCH_API_KEY=
