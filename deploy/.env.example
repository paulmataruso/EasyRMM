# EasyRMM deployment settings. scripts/setup.sh writes deploy/.env from this
# template with freshly generated secrets. Never commit deploy/.env.

# Public address of the web interface and agent gateway. A DNS name is
# recommended; a server without DNS can use its IP address instead
# (https://203.0.113.10), see docs/architecture/adr/0016-ip-address-access.md.
EASYRMM_PUBLIC_URL=https://rmm.example.com
# Remote access (MeshCentral) uses its own origin; defaults to
# https://mesh.<public host>, or https://<address>:4443 for an IP address.
# Both names must resolve to this server, and must share a parent domain
# (rmm.example.com and mesh.rmm.example.com) so browsers treat the embedded
# sessions as same-site.
EASYRMM_MESH_PUBLIC_URL=
# Set to false to run without remote access (then do not start the
# meshcentral service).
EASYRMM_MESH_ENABLED=true
# Where MeshCentral reads the certificate agents pin. Leave empty for the
# default: this server's HTTPS listener, or in offload mode https://127.0.0.1:443
# (your proxy). file:///easyrmm/config/<name>.pem also works.
EASYRMM_MESH_CERT_URL=

# TLS: acme (Let's Encrypt), manual (your certificate files), internal (the
# server's own certificate authority, the default for an IP address) or
# offload (TLS terminated by your reverse proxy; see docs/deployment/nginx.md).
EASYRMM_TLS_MODE=acme
EASYRMM_ACME_EMAIL=you@example.com
# Port 80 serves ACME HTTP-01 challenges and redirects to HTTPS. Set to an
# empty value to disable it (ACME then uses TLS-ALPN-01 on 443).
EASYRMM_LISTEN_HTTP=:80
# HTTPS on every address by default. On a host with several addresses, name
# one, e.g. 203.0.113.10:443. Remote sessions on an IP address listen on the
# same address, at EASYRMM_IP_MESH_PORT.
EASYRMM_LISTEN_HTTPS=:443
# manual mode: paths inside the container; EASYRMM_TLS_DIR is mounted at
# /etc/easyrmm/tls.
EASYRMM_TLS_DIR=/srv/easyrmm/tls
EASYRMM_TLS_CERT_FILE=
EASYRMM_TLS_KEY_FILE=
# offload mode: addresses of your reverse proxy, e.g. 127.0.0.1/32.
EASYRMM_TRUSTED_PROXIES=

# IP access: the console and remote sessions also answer on this server's
# IP addresses, so you can get in when DNS is not working. Those addresses
# use a certificate from the server's own certificate authority (the console
# shows it under Devices -> Add devices). Set to false to serve the public
# URL only.
EASYRMM_IP_ACCESS=true
# Addresses to answer on, comma-separated. Empty: the server's primary
# addresses. Behind NAT, list the public address too.
EASYRMM_IP_ADDRESSES=
# Port for remote sessions on an IP address; open it in your firewall.
EASYRMM_IP_MESH_PORT=4443

# EasyPatch on this same server (docs/deployment/easypatch-cohost.md): its
# public name. EasyRMM keeps ports 80 and 443 and passes this name through
# to EasyPatch's own listener on 127.0.0.1:19443 (and its certificate
# challenges to 127.0.0.1:19080). Empty: EasyPatch is not on this server.
EASYRMM_EASYPATCH_HOSTNAME=

# Patching engine inside this deployment (docs/architecture/one-product-plan.md,
# phase B). "bundled" runs EasyPatch's engine here, on loopback, and
# EasyRMM's patching pages use it instead of a server set up in Settings. It
# needs COMPOSE_PROFILES=patching so that docker compose starts its services;
# scripts/setup.sh --patching bundled sets both. Empty: patching uses an
# EasyPatch server connected in Settings. Until the plan's switch-over the
# bundle is for testing only.
EASYRMM_PATCHING=
COMPOSE_PROFILES=
# The engine's image, from a clone: docker compose builds it from this
# repository (tag "dev"). A release bundle's docker-compose.yml names the
# engine of that release by digest and ignores these two.
EASYPATCH_IMAGE=ghcr.io/paulmataruso/easypatch-server
EASYPATCH_VERSION=dev
# Where persistent data lives on the host.
EASYRMM_DATA_ROOT=/srv/easyrmm

# Image to run (leave as is to use published releases).
EASYRMM_IMAGE=ghcr.io/paulmataruso/easyrmm-server
EASYRMM_VERSION=latest

# --- Secrets (generated by scripts/setup.sh) ---------------------------------
# Back these up with your database backups. Losing EASYRMM_SECRET_KEY makes
# stored second factors and integration credentials unreadable.
POSTGRES_PASSWORD=
EASYRMM_DB_OWNER_PASSWORD=
EASYRMM_DB_APP_PASSWORD=
EASYRMM_SECRET_KEY=
EASYRMM_SECRET_KEY_ID=k1
# The patching engine's database roles, and the key EasyRMM signs its calls
# to the engine with (used with EASYRMM_PATCHING=bundled). setup.sh adds
# them to an older .env that lacks them.
EASYPATCH_DB_OWNER_PASSWORD=
EASYPATCH_DB_APP_PASSWORD=
EASYRMM_PATCHING_KEY=
# Former keys still accepted for decryption after a rotation: id:base64,...
EASYRMM_SECRET_KEYS_PREVIOUS=

# --- Optional ----------------------------------------------------------------
EASYRMM_REQUIRE_MFA=true
# Outbound e-mail for invitations and password resets.
EASYRMM_SMTP_HOST=
EASYRMM_SMTP_PORT=587
EASYRMM_SMTP_USERNAME=
EASYRMM_SMTP_PASSWORD=
EASYRMM_SMTP_FROM=
EASYRMM_SMTP_TLS=starttls
EASYRMM_LOG_LEVEL=info
