# EasyRMM deployment settings. scripts/setup.sh writes deploy/.env from this
# template with freshly generated secrets. Never commit deploy/.env.

# Public address of the web interface and agent gateway. A DNS name is
# recommended; a server without DNS can use its IP address instead
# (https://203.0.113.10), see docs/architecture/adr/0016-ip-address-access.md.
EASYRMM_PUBLIC_URL=https://rmm.example.com
# Remote access (MeshCentral) uses its own origin; defaults to
# https://mesh.<public host>, or https://<address>:4443 for an IP address.
# Both names must resolve to this server, and must share a parent domain
# (rmm.example.com and mesh.rmm.example.com) so browsers treat the embedded
# sessions as same-site.
EASYRMM_MESH_PUBLIC_URL=
# Set to false to run without remote access (then do not start the
# meshcentral service).
EASYRMM_MESH_ENABLED=true
# Where MeshCentral reads the certificate agents pin. Leave empty for the
# default: this server's HTTPS listener, or in offload mode https://127.0.0.1:443
# (your proxy). file:///easyrmm/config/<name>.pem also works.
EASYRMM_MESH_CERT_URL=

# TLS: acme (Let's Encrypt), manual (your certificate files), internal (the
# server's own certificate authority, the default for an IP address) or
# offload (TLS terminated by your reverse proxy; see docs/deployment/nginx.md).
EASYRMM_TLS_MODE=acme
EASYRMM_ACME_EMAIL=you@example.com
# Another ACME certificate authority's directory, such as a private one;
# empty uses Let's Encrypt.
EASYRMM_ACME_DIRECTORY=
# Port 80 serves ACME HTTP-01 challenges and redirects to HTTPS. Set to an
# empty value to disable it (ACME then uses TLS-ALPN-01 on 443).
EASYRMM_LISTEN_HTTP=:80
# HTTPS on every address by default. On a host with several addresses, name
# one, e.g. 203.0.113.10:443. Remote sessions on an IP address listen on the
# same address, at EASYRMM_IP_MESH_PORT.
EASYRMM_LISTEN_HTTPS=:443
# manual mode: paths inside the container; EASYRMM_TLS_DIR is mounted at
# /etc/easyrmm/tls.
EASYRMM_TLS_DIR=/srv/easyrmm/tls
EASYRMM_TLS_CERT_FILE=
EASYRMM_TLS_KEY_FILE=
# offload mode: addresses of your reverse proxy, e.g. 127.0.0.1/32.
EASYRMM_TRUSTED_PROXIES=

# IP access: the console and remote sessions also answer on this server's
# IP addresses, so you can get in when DNS is not working. Those addresses
# use a certificate from the server's own certificate authority (the console
# shows it under Devices -> Add devices). Set to false to serve the public
# URL only.
EASYRMM_IP_ACCESS=true
# Addresses to answer on, comma-separated. Empty: the server's primary
# addresses. Behind NAT, list the public address too.
EASYRMM_IP_ADDRESSES=
# Port for remote sessions on an IP address; open it in your firewall.
EASYRMM_IP_MESH_PORT=4443

# Patching: EasyPatch's engine runs in this deployment, on loopback, and
# EasyRMM's patching pages use it (docs/operations/patching.md).
# The names of a standalone EasyPatch imported into this deployment, comma-
# separated (for example patch.example.com). Its agents keep the address they
# enrolled with, so EasyRMM answers it for them: their paths go to the engine,
# and a person opening it is sent to EasyRMM's patching pages. Point the
# name's DNS at this server; it gets its certificate as EasyRMM's own names do.
EASYRMM_PATCHING_AGENT_HOSTNAMES=
# The engine's image, from a clone: docker compose builds it from this
# repository (tag "dev"). A release bundle's docker-compose.yml names the
# engine of that release by digest and ignores these two.
EASYPATCH_IMAGE=ghcr.io/paulmataruso/easypatch-server
EASYPATCH_VERSION=dev
# Where persistent data lives on the host.
EASYRMM_DATA_ROOT=/srv/easyrmm

# The keystore (ADR-0081; docs/operations/keystore.md) keeps the key that protects
# BitLocker and LUKS recovery keys. Its state directory is kept apart from the
# data root and the deployment directory, so no backup copies it.
EASYRMM_KEYSTORE_DIR=/var/lib/easyrmm-keystore
# Empty: the host's TPM where it has one, else a passphrase typed at the host after
# each start. "file" keeps the key in a file in the state directory: a named
# stand-in for a host with neither, off unless set here.
EASYRMM_KEYSTORE_MODE=
# Set by setup.sh when the host has a TPM 2.0 (/dev/tpmrm0) and the group that may open it.
EASYRMM_TPM_DEVICE=
EASYRMM_TPM_GID=

# Image to run (leave as is to use published releases).
EASYRMM_IMAGE=ghcr.io/paulmataruso/easyrmm-server
EASYRMM_VERSION=latest

# --- Sign-in with Authentik (scripts/setup.sh --with-authentik) ---------------
# Authentik in this deployment as everyone's sign-in, with a second factor at
# every sign-in (ADR-0044). setup.sh --with-authentik fills this block and
# adds "authentik" to COMPOSE_PROFILES. Empty hostname: no Authentik.
#
# Authentik's own name, such as auth.example.com: point its DNS at this
# server. EasyRMM's edge serves it with a certificate from the same source as
# its own names (not with EASYRMM_TLS_MODE=offload).
EASYRMM_AUTHENTIK_HOSTNAME=
# The first super administrator, created with this address and no password;
# the invitation setup.sh prints makes their Authentik account. Only addresses
# in its domain can sign in through Authentik.
EASYRMM_AUTHENTIK_ADMIN_EMAIL=
# Secrets, generated by setup.sh: EasyRMM's client secret at Authentik,
# Authentik's own secret key, and its database role's password. Authentik's
# akadmin password is in ${EASYRMM_DATA_ROOT}/authentik/secrets/akadmin-password.
EASYRMM_AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_PASSWORD=

# --- Secrets (generated by scripts/setup.sh) ---------------------------------
# Back these up with your database backups. Losing EASYRMM_SECRET_KEY makes
# stored second factors and integration credentials unreadable.
POSTGRES_PASSWORD=
EASYRMM_DB_OWNER_PASSWORD=
EASYRMM_DB_APP_PASSWORD=
EASYRMM_SECRET_KEY=
EASYRMM_SECRET_KEY_ID=k1
# The patching engine's database roles, and the key EasyRMM signs its calls
# to the engine with. setup.sh adds them to an older .env that lacks them.
EASYPATCH_DB_OWNER_PASSWORD=
EASYPATCH_DB_APP_PASSWORD=
EASYRMM_PATCHING_KEY=
# Former keys still accepted for decryption after a rotation: id:base64,...
EASYRMM_SECRET_KEYS_PREVIOUS=

# --- Optional ----------------------------------------------------------------
EASYRMM_REQUIRE_MFA=true
# Outbound e-mail for invitations, password resets, patch reports and
# patching alerts. Usually set in the console instead (Settings ->
# Notifications -> Mail server, docs/operations/mail.md); when
# EASYRMM_SMTP_HOST is set here, it wins and the console shows it read-only.
# EASYRMM_SMTP_TLS: starttls, implicit (TLS from the first byte), or none
# (only to a relay on this machine). EASYRMM_SMTP_FROM may carry a name, in
# double quotes: EASYRMM_SMTP_FROM="EasyRMM <rmm@example.com>". In double
# quotes, write \" for a quote, \\ for a backslash and $$ for a $
# (docs/operations/updater.md#env).
EASYRMM_SMTP_HOST=
EASYRMM_SMTP_PORT=587
EASYRMM_SMTP_USERNAME=
EASYRMM_SMTP_PASSWORD=
EASYRMM_SMTP_FROM=
EASYRMM_SMTP_TLS=starttls
# How EasyRMM signs in: none, password (the default with a user name) or
# microsoft365, a Microsoft 365 application (ADR-0053) signing in to
# EASYRMM_SMTP_FROM's mailbox at smtp.office365.com, port 587, starttls. The
# patching engine cannot sign in that way: it is given no mail server, and
# patching sends no email meanwhile. Its Directory (tenant) ID, or a domain
# name of the tenant, and its Application (client) ID; then its client
# secret, or its certificate and RSA private key (PEM), each only in a file
# under ${EASYRMM_DATA_ROOT}/secrets (root:65532, 0750; files 0440), named by
# its path in the server's container, /run/secrets/easyrmm/. setup.sh
# --smtp-tenant-id and the other --smtp-* options write all of this.
EASYRMM_SMTP_AUTH=
EASYRMM_SMTP_TENANT_ID=
EASYRMM_SMTP_CLIENT_ID=
EASYRMM_SMTP_CLIENT_SECRET_FILE=
EASYRMM_SMTP_CLIENT_CERT_FILE=
EASYRMM_SMTP_CLIENT_KEY_FILE=
EASYRMM_LOG_LEVEL=info
