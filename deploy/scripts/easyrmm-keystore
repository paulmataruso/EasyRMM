#!/usr/bin/env bash
# Runs the keystore's host commands in its container (ADR-0081, docs/operations/keystore.md):
#   ./scripts/easyrmm-keystore init | status | unseal | verify-recovery --bundle FILE | new-version
# Run from anywhere; it uses the deployment this script belongs to. The commands reach
# the keystore over a socket that exists inside the container only, so the console
# and the server cannot feed or capture a passphrase or a recovery code.
set -euo pipefail
cd "$(dirname "$0")/.."
exec docker compose exec keystore /usr/local/bin/easyrmm-keystore "$@"
