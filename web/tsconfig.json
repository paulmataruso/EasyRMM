{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "e2e", "e2e-sign-in", "e2e-bundle", "e2e-authentik", "screenshots", "vite.config.ts", "playwright.config.ts", "playwright.sign-in.config.ts", "playwright.bundle.config.ts", "playwright.authentik.config.ts", "playwright.screenshots.config.ts"]
}
