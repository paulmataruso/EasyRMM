# Keep the build context small and free of secrets.
.git
# EasyPatch builds from its own folder, with its own .dockerignore. Its folder
# also holds its .env, database password and release signing key.
easypatch
.github
.claude
.impeccable
**/node_modules
web/dist
web/coverage
# End-to-end run data includes a live setup token and server data.
web/e2e/.run
web/e2e/.results
web/e2e/.report
server/internal/webui/dist/*
!server/internal/webui/dist/.gitkeep
coverage*
*.out
.env
.env.*
deploy/.env
docs
tests
**/*.md
!web/**/*.md
