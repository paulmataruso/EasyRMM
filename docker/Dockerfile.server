# EasyRMM Server — Multi-stage build
# Produces a minimal container with a static Go binary.

# ── Stage 1: Build ───────────────────────────────────────────────
FROM golang:1.23-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /out/easyrmmserver ./cmd/easyrmmserver

# ── Stage 2: Runtime ─────────────────────────────────────────────
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata wget \
    && addgroup -S easyrm && adduser -S easyrm -G easyrm

COPY --from=builder /out/easyrmmserver /usr/local/bin/easyrmmserver
COPY migrations /app/migrations
COPY docker/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# Frontend static assets are embedded in the Go binary or served from this dir
COPY frontend/dist /app/frontend/dist

WORKDIR /app
USER easyrm

ENTRYPOINT ["/app/docker-entrypoint.sh"]
