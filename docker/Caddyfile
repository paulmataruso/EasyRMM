# EasyRMM Caddy Configuration
# Single entry point on ports 443 (HTTPS) and 80 (redirect + ACME).
# Routes traffic to the Go backend and MeshCentral.

{
	# Use ACME_EMAIL for Let's Encrypt; leave empty for staging
	email {$ACME_EMAIL:}
}

# Health check endpoint on port 80 — used by Docker healthcheck
:80 {
	respond /healthz "OK" 200

	# Redirect everything else to HTTPS
	redir * https://{$EASYRM_DOMAIN}{uri} permanent
}

{$EASYRM_DOMAIN} {
	# ── Encoding ─────────────────────────────────────────────
	encode zstd gzip

	# ── Security headers ─────────────────────────────────────
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-XSS-Protection "0"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Remove server identification
		-Server
	}

	# ── MeshCentral agent WebSocket connections ──────────────
	# MeshAgent connects to /meshagent on port 443; forward to MeshCentral.
	@meshagent path /meshagent*
	handle @meshagent {
		reverse_proxy http://127.0.0.1:4430 {
			# Long-lived agent WebSocket connections
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ── MeshCentral web interface (proxied, prefix stripped) ─
	# Our frontend loads MeshCentral remote desktop in iframes via /mesh/
	@mesh path /mesh /mesh/*
	handle @mesh {
		uri strip_prefix /mesh
		reverse_proxy http://127.0.0.1:4430 {
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Prefix /mesh
		}
	}

	# ── EasyRMM API ──────────────────────────────────────────
	@api path /api/*
	handle @api {
		reverse_proxy http://127.0.0.1:8443 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ── EasyRMM WebSocket ────────────────────────────────────
	@ws path /ws/*
	handle @ws {
		reverse_proxy http://127.0.0.1:8443 {
			transport http {
				read_timeout 0
				write_timeout 0
			}
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ── Frontend (SPA fallback) ──────────────────────────────
	# Go backend serves the React SPA and handles SPA routing fallback.
	handle {
		reverse_proxy http://127.0.0.1:8443 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
