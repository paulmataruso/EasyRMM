<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Authors>DHI Technical Services LLC</Authors>
    <Company>DHI Technical Services LLC</Company>
    <Product>EasyPatch</Product>
    <Copyright>Copyright (c) 2026 DHI Technical Services LLC. Licensed under the Functional Source License, Version 1.1, ALv2 Future License (FSL-1.1-ALv2).</Copyright>
    <!-- Single source of truth for product version; overridden by CI with -p:Version=x.y.z -->
    <Version>1.10.0</Version>
    <!-- Allow building Windows-targeted agent projects on Linux build hosts -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- CA1848/CA1873: LoggerMessage source-gen is not required for this codebase's log volume;
         CA1515: public types in apps are fine; CA2007: no ConfigureAwait in app code;
         CA1031: catch-all is used deliberately at process boundaries (always logged). -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1515;CA2007;CA1031;CA1724;CA1716;CA1056;CA1054;CA1055;CA1062;CA1303;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1863;CA1002;CA2227;CA1819;CA1028;CA1008;CA1711;CA1720;CA1034;CA1032;CA1064;CA2201;CA1822;CA1859;CA5394;CA1805;CA1812;CA1852;CA2234;CA1865;CA1866;CA1867;CA1861</NoWarn>
  </PropertyGroup>
</Project>
