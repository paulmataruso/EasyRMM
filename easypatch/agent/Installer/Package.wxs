<?xml version="1.0" encoding="utf-8"?>
<!--
  EasyPatch Agent MSI (WiX Toolset v5).

  Public properties (all optional on upgrade; SERVERURL is required on first install):
    SERVERURL        https:// URL of the patching server (EasyRMM's address)
    ENROLLMENTTOKEN  limited-use enrollment token (hidden: never written to MSI logs)
    PROXYURL         optional http(s) proxy for the agent's connection to the server
    SERVERCACERT     optional certificate authority (base64 DER) the agent trusts for its connection to the server only,
                     for servers with a private CA (EasyRMM passes it when it installs the agent)

  The UpgradeCode below must never change: it is what lets new versions upgrade old ones.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="EasyPatch Agent"
           Manufacturer="EasyPatch"
           Version="$(var.ProductVersion)"
           UpgradeCode="FFC8A7E3-FD7E-4FE0-9494-327AA9E089E4"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="EasyPatch Agent $(var.ProductVersion)" Manufacturer="EasyPatch" />

    <!-- Remove the old version first (its uninstall skips unenrollment because UPGRADINGPRODUCTCODE is set). -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Installed apps / Programs and Features icon (the agent executable carries the same icon). -->
    <Icon Id="EasyPatch.ico" SourceFile="$(sys.SOURCEFILEDIR)..\EasyPatch.Agent\EasyPatch.ico" />
    <Property Id="ARPPRODUCTICON" Value="EasyPatch.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCOMMENTS" Value="Windows Update agent for the self-hosted EasyPatch patch management platform." />

    <!-- ===================================================================== properties -->

    <Property Id="SERVERURL" Secure="yes" />
    <Property Id="PROXYURL" Secure="yes" />
    <Property Id="SERVERCACERT" Secure="yes" />
    <Property Id="ENROLLMENTTOKEN" Secure="yes" Hidden="yes" />

    <!-- The default WriteRegistryValues progress template ("Key: [1], Name: [2], Value: [3]") would put the enrollment
         token into verbose MSI logs. Log the key and value name only. -->
    <UI>
      <ProgressText Action="WriteRegistryValues" Message="Writing system registry values" Template="Key: [1], Name: [2]" />
    </UI>

    <!-- Remember SERVERURL / PROXYURL / SERVERCACERT across upgrades and repairs (command-line values win). -->
    <Property Id="SAVEDSERVERURL" Secure="yes">
      <RegistrySearch Id="SavedServerUrl" Root="HKLM" Key="SOFTWARE\EasyPatch\Agent" Name="ServerUrl" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="SAVEDPROXYURL" Secure="yes">
      <RegistrySearch Id="SavedProxyUrl" Root="HKLM" Key="SOFTWARE\EasyPatch\Agent" Name="ProxyUrl" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="SAVEDSERVERCACERT" Secure="yes">
      <RegistrySearch Id="SavedServerCaCertificate" Root="HKLM" Key="SOFTWARE\EasyPatch\Agent" Name="ServerCaCertificate" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="SERVERURL" Value="[SAVEDSERVERURL]" After="AppSearch" Sequence="first" Condition="NOT SERVERURL AND SAVEDSERVERURL" />
    <SetProperty Id="PROXYURL" Value="[SAVEDPROXYURL]" After="AppSearch" Sequence="first" Condition="NOT PROXYURL AND SAVEDPROXYURL" />
    <SetProperty Id="SERVERCACERT" Value="[SAVEDSERVERCACERT]" After="AppSearch" Sequence="first" Condition="NOT SERVERCACERT AND SAVEDSERVERCACERT" />

    <Launch Condition="Privileged" Message="The EasyPatch Agent must be installed by an administrator." />
    <Launch Condition="Installed OR (SERVERURL ~&lt;&lt; &quot;https://&quot;)"
            Message="SERVERURL is required and must start with https:// (for example: msiexec /i EasyPatchAgent.msi SERVERURL=https://patch.example.com ENROLLMENTTOKEN=...)." />
    <Launch Condition="VersionNT64 AND (VersionNT &gt;= 603)"
            Message="The EasyPatch Agent requires 64-bit Windows 10 / Windows Server 2016 or later." />

    <!-- ===================================================================== layout -->

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="EasyPatch Agent" />
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="EasyPatch">
        <!-- ADR-0070: where winget and msiexec keep their temporary files, and where each .NET service or command extracts
             its single file (one folder each, never shared). All under the data folder, so all locked down and excluded with it. -->
        <Directory Id="WORKFOLDER" Name="work" />
        <Directory Id="BUNDLEFOLDER" Name="bundle">
          <Directory Id="BUNDLESERVICEFOLDER" Name="EasyPatchAgent" />
          <Directory Id="BUNDLEUNENROLLFOLDER" Name="unenroll" />
          <Directory Id="BUNDLEDEFENDERFOLDER" Name="defender" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Agent" Title="EasyPatch Agent" Level="1">
      <ComponentGroupRef Id="AgentComponents" />
    </Feature>

    <!-- ===================================================================== Microsoft Defender (ADR-0070) -->

    <!-- The order of an install is: create the folders (CreateFolders), lock them down, verify them, exclude them, and only then lay
         down the files (InstallFiles). The program is not on disk yet, so the first half is this fixed PowerShell text, run by
         DefenderPreExclude between CreateFolders and InstallFiles: it locks down the two folders with the access lists below,
         verifies them (a plain folder, an owner that is SYSTEM, Administrators or TrustedInstaller, no one else who may write it,
         nothing above it that others may replace), and adds the path and Attack Surface Reduction exclusions of the verified
         folders, writing state\defender-exclusions.json BEFORE each add. The paths are fixed from the system folders, never from
         a property. After the files are laid down, DefenderExclude runs the agent's own "defender add", which repeats the full
         check (the whole subtree) and adds the process and Controlled Folder Access exclusions. A third-party antivirus, Defender
         in passive mode or switched off, or a missing Defender module changes nothing here (state not_applicable), and no failure
         of either step fails the installation. The value is a property so that its text is never formatted by Windows Installer;
         it is private (mixed case) and holds no double quote. -->
    <Property Id="DefenderPreScript" Value="$ErrorActionPreference = 'Stop';
$trusted = @('S-1-5-18', 'S-1-5-32-544', 'S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464');
$pf = Join-Path $env:ProgramFiles 'EasyPatch Agent';
$pd = Join-Path $env:ProgramData 'EasyPatch';
$sddlData = 'O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)';
$sddlProgram = 'O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)';
function Lock($d, $sddl) { New-Item -ItemType Directory -Force -Path $d | Out-Null; $a = New-Object System.Security.AccessControl.DirectorySecurity; $a.SetSecurityDescriptorSddlForm($sddl); Set-Acl -LiteralPath $d -AclObject $a };
function Problem($d, $mask, $self) {
  $i = Get-Item -LiteralPath $d -Force;
  if ($i.Attributes -band 1024) { return ($d + ' is a link') };
  $a = Get-Acl -LiteralPath $d;
  $t = ('System.Security.Principal.SecurityIdentifier' -as 'type');
  $o = $a.GetOwner($t).Value;
  if ($trusted -notcontains $o) { return ($d + ' is owned by ' + $o) };
  foreach ($r in $a.GetAccessRules($true, $true, $t)) {
    if ($r.AccessControlType -ne 'Allow') { continue };
    if (($r.FileSystemRights.value__ -band $mask) -eq 0) { continue };
    if ((-not $self) -and ($r.PropagationFlags.value__ -band 2)) { continue };
    $w = $r.IdentityReference.Value;
    if (($trusted -contains $w) -or ($w -eq 'S-1-3-0') -or ($w -eq 'S-1-3-1')) { continue };
    return ($d + ' may be changed by ' + $w)
  };
  return $null
};
Lock $pd $sddlData; Lock $pf $sddlProgram;
$ok = @();
foreach ($d in @($pf, $pd)) {
  $own = Problem $d 0x500D0156 $true;
  $above = Problem (Split-Path -Parent $d) 0x100D0040 $false;
  if ((-not $own) -and (-not $above)) { $ok += $d }
};
if ($ok.Count -eq 0) { exit 0 };
if (-not (Get-Command Get-MpPreference -ErrorAction SilentlyContinue)) { exit 0 };
$s = Get-MpComputerStatus; $p = Get-MpPreference;
if (($s.AMRunningMode -ne 'Normal') -or (-not $s.AntivirusEnabled) -or (-not $s.RealTimeProtectionEnabled)) { exit 0 };
$rec = Join-Path $pd 'state\defender-exclusions.json';
$entries = @();
if (Test-Path -LiteralPath $rec) { $j = Get-Content -Raw -LiteralPath $rec | ConvertFrom-Json; if ($j.version -ne 1) { exit 0 }; $entries = @($j.entries) };
function Save { New-Item -ItemType Directory -Force -Path (Split-Path -Parent $rec) | Out-Null; $json = ConvertTo-Json -Depth 4 @{ version = 1; entries = @($entries) }; $w = New-Object System.IO.StreamWriter($rec, $false, (New-Object System.Text.UTF8Encoding($false))); $w.Write($json); $w.Close() };
foreach ($d in $ok) {
  foreach ($k in @('path', 'asr')) {
    $param = @{ path = 'ExclusionPath'; asr = 'AttackSurfaceReductionOnlyExclusions' }.$k;
    $list = @($p.$param);
    if (@($list | Where-Object { $_ -ieq $d }).Count -gt 0) { continue };
    $entries = @($entries) + (New-Object psobject -Property @{ kind = $k; path = $d; at = (Get-Date).ToUniversalTime().ToString('o'); agentVersion = $v });
    Save;
    try { $x = @{ $param = $d }; Add-MpPreference @x }
    catch { $entries = @($entries | Where-Object { -not (($_.kind -eq $k) -and ($_.path -eq $d)) }); Save }
  }
}" />

    <CustomAction Id="DefenderPreExclude"
                  Directory="TARGETDIR"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$v='[ProductVersion]'; [DefenderPreScript]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- The agent's own command, after the files are laid down. The command gets its own extraction folder: cmd sets the variable for it
         alone, since a custom action does not inherit the service's environment. -->
    <CustomAction Id="DefenderExclude"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /d /s /c &quot;set &quot;DOTNET_BUNDLE_EXTRACT_BASE_DIR=[DATAFOLDER]bundle\defender&quot;&amp;&amp; &quot;[INSTALLFOLDER]EasyPatch.Agent.exe&quot; defender add&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Moves the service's single-file extraction into its own folder under the data folder, in the service's own Environment value
         and nowhere else (never machine-wide). The service key exists once InstallServices has run. -->
    <CustomAction Id="ServiceBundleEnvironment"
                  Directory="TARGETDIR"
                  ExeCommand="&quot;[SystemFolder]reg.exe&quot; add HKLM\SYSTEM\CurrentControlSet\Services\EasyPatchAgent /v Environment /t REG_MULTI_SZ /d &quot;DOTNET_BUNDLE_EXTRACT_BASE_DIR=[DATAFOLDER]bundle\EasyPatchAgent&quot; /f"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- On a real removal (never an upgrade) the agent removes exactly the exclusions it recorded, before the identity is deleted. -->
    <CustomAction Id="DefenderRemove"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /d /s /c &quot;set &quot;DOTNET_BUNDLE_EXTRACT_BASE_DIR=[DATAFOLDER]bundle\defender&quot;&amp;&amp; &quot;[INSTALLFOLDER]EasyPatch.Agent.exe&quot; defender remove&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- ===================================================================== uninstall -->

    <!-- Best-effort server notification and deletion of the agent identity on a real uninstall
         (never during a major upgrade). Exit code is ignored: uninstall must not fail when the server is down. -->
    <CustomAction Id="UnenrollAgent"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /d /s /c &quot;set &quot;DOTNET_BUNDLE_EXTRACT_BASE_DIR=[DATAFOLDER]bundle\unenroll&quot;&amp;&amp; &quot;[INSTALLFOLDER]EasyPatch.Agent.exe&quot; unenroll --reason &quot;Agent uninstalled&quot;&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- Install order (ADR-0070): CreateFolders, lock down + verify + exclude, then InstallFiles. -->
      <Custom Action="DefenderPreExclude" After="CreateFolders" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="ServiceBundleEnvironment" After="InstallServices" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="DefenderExclude" After="ServiceBundleEnvironment" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <!-- Removal: the exclusions first, then the identity. An upgrade keeps the exclusions. -->
      <Custom Action="DefenderRemove" After="StopServices" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="UnenrollAgent" After="DefenderRemove" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <ComponentGroup Id="AgentComponents">

      <!-- Service executable (self-contained single file). -->
      <Component Id="AgentService" Directory="INSTALLFOLDER" Bitness="always64">
        <File Id="AgentExe" Source="$(var.PublishDir)EasyPatch.Agent.exe" KeyPath="yes" />

        <ServiceInstall Id="AgentServiceInstall"
                        Name="EasyPatchAgent"
                        DisplayName="EasyPatch Agent"
                        Description="Reports Windows Update status to the patching server, installs approved updates and carries out restarts requested by an administrator."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Arguments="run"
                        Vital="yes">
          <!-- MsiServiceConfig (Windows Installer 5.0) is the only declarative way to set delayed auto-start and to make
               recovery actions apply when the service stops with an error exit code. WiX warns about it (WIX1149); the
               util:ServiceConfig alternative below covers restart actions but not these two settings. -->
          <ServiceConfig DelayedAutoStart="yes" FailureActionsWhen="failedToStopOrReturnedError" OnInstall="yes" OnReinstall="yes" />
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="60"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="AgentServiceControl" Name="EasyPatchAgent" Start="install" Stop="both" Remove="uninstall" Wait="yes" />

        <util:EventSource Name="EasyPatch Agent"
                          Log="Application"
                          EventMessageFile="[WindowsFolder]Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll" />
      </Component>

      <!-- Data directory: keys, state, outbox and logs. SYSTEM and Administrators only, inheritance disabled. -->
      <Component Id="DataFolder" Directory="DATAFOLDER" Guid="7D0D9C51-3E58-4B0B-9F0E-2B7C8B0E5A11" Bitness="always64">
        <CreateFolder>
          <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
        </CreateFolder>
      </Component>

      <!-- ADR-0070: the program folder, which Program Files only lets SYSTEM, Administrators and TrustedInstaller change by
           inheritance and nothing enforced: SYSTEM and Administrators full control, Users read and execute (the tray runs the program
           in each user's session), inheritance off. The agent sets and verifies the same list at every start. -->
      <Component Id="InstallFolder" Directory="INSTALLFOLDER" Guid="A2C8F1D4-6B7E-4E35-9C1A-5D3F8B2E7A64" Bitness="always64">
        <CreateFolder>
          <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
        </CreateFolder>
      </Component>

      <!-- ADR-0070: the work and extraction folders, locked down like the data folder they are in. -->
      <Component Id="WorkFolder" Directory="WORKFOLDER" Guid="B3D9E2A5-7C8F-4F46-8D2B-6E4A9C3F8B75" Bitness="always64">
        <CreateFolder><PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" /></CreateFolder>
      </Component>
      <Component Id="BundleFolder" Directory="BUNDLEFOLDER" Guid="C4EAF3B6-8D90-4A57-9E3C-7F5BAD4A9C86" Bitness="always64">
        <CreateFolder><PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" /></CreateFolder>
      </Component>
      <Component Id="BundleServiceFolder" Directory="BUNDLESERVICEFOLDER" Guid="D5FB04C7-9EA1-4B68-8F4D-806CBE5BAD97" Bitness="always64">
        <CreateFolder><PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" /></CreateFolder>
      </Component>
      <Component Id="BundleUnenrollFolder" Directory="BUNDLEUNENROLLFOLDER" Guid="E60C15D8-AFB2-4C79-9A5E-917DCF6CBEA8" Bitness="always64">
        <CreateFolder><PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" /></CreateFolder>
      </Component>
      <Component Id="BundleDefenderFolder" Directory="BUNDLEDEFENDERFOLDER" Guid="F71D26E9-B0C3-4D8A-8B6F-A28E0D7DCFB9" Bitness="always64">
        <CreateFolder><PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" /></CreateFolder>
      </Component>

      <!-- Bootstrap registry key, restricted to SYSTEM and Administrators (it may briefly hold an enrollment token). -->
      <Component Id="RegistryKey" Directory="INSTALLFOLDER" Guid="5F3B7E1C-8A2D-4C61-9E4B-6D2A1C7F9B30" Bitness="always64">
        <RegistryKey Root="HKLM" Key="SOFTWARE\EasyPatch\Agent" ForceCreateOnInstall="yes">
          <PermissionEx Sddl="O:BAG:SYD:PAI(A;CI;KA;;;SY)(A;CI;KA;;;BA)" />
          <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        </RegistryKey>
      </Component>

      <Component Id="RegistryServerUrl" Directory="INSTALLFOLDER" Guid="0B6E2F4A-91C3-4D7E-8A55-3F1B2C9D7E61" Bitness="always64" Condition="SERVERURL">
        <RegistryValue Root="HKLM" Key="SOFTWARE\EasyPatch\Agent" Name="ServerUrl" Type="string" Value="[SERVERURL]" KeyPath="yes" />
      </Component>

      <Component Id="RegistryProxyUrl" Directory="INSTALLFOLDER" Guid="C4A1E8D2-6B3F-4A90-B2D7-8E5F1A3C6B42" Bitness="always64" Condition="PROXYURL">
        <RegistryValue Root="HKLM" Key="SOFTWARE\EasyPatch\Agent" Name="ProxyUrl" Type="string" Value="[PROXYURL]" KeyPath="yes" />
      </Component>

      <Component Id="RegistryServerCaCertificate" Directory="INSTALLFOLDER" Guid="3D8A5F27-C61E-4B94-9F03-7A2E5B8C1D46" Bitness="always64" Condition="SERVERCACERT">
        <RegistryValue Root="HKLM" Key="SOFTWARE\EasyPatch\Agent" Name="ServerCaCertificate" Type="string" Value="[SERVERCACERT]" KeyPath="yes" />
      </Component>

      <!-- Consumed and deleted by the agent after enrollment; written only when supplied on this install. -->
      <Component Id="RegistryEnrollmentToken" Directory="INSTALLFOLDER" Guid="9E2D6A41-5C7B-4F83-A1E9-2B4D8C6F0A73" Bitness="always64" Condition="ENROLLMENTTOKEN">
        <RegistryValue Root="HKLM" Key="SOFTWARE\EasyPatch\Agent" Name="EnrollmentToken" Type="string" Value="[ENROLLMENTTOKEN]" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
