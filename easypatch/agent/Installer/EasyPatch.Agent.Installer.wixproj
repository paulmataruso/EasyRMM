<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    Builds EasyPatchAgent.msi from a published agent (scripts: agent/Installer/build-installer.ps1).
    Windows (WiX uses the Windows Installer API). On Linux, scripts/build-msi-linux.sh compiles Package.wxs with the
    same WiX version under Wine. Not part of EasyPatch.slnx.

      dotnet build agent/Installer/EasyPatch.Agent.Installer.wixproj -c Release
        -p:ProductVersion=1.2.3 -p:PublishDir=<abs path to publish output>\ -p:InstallerPlatform=x64
  -->
  <PropertyGroup>
    <!-- WiX packages are pinned here; they are build tools, not part of the .NET package graph. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <OutputType>Package</OutputType>
    <OutputName>EasyPatchAgent</OutputName>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.2.0</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\agent\win-$(InstallerPlatform)\</PublishDir>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir)</DefineConstants>
    <!-- ICE validation warnings are reported but do not fail the build (they cannot be verified on non-Windows CI). -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
