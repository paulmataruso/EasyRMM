#!/bin/sh
set -e

if [ "$1" = "remove" ]; then
    if [ -d /run/systemd/system ]; then
        systemctl disable --now easypatch-agent.service >/dev/null 2>&1 || true
    fi
    # Best effort, like the Windows uninstaller: tell the server and delete the agent identity.
    # Never on upgrade. The removal must not fail when the server is down.
    if [ -x /opt/easypatch/easypatch-agent ]; then
        /opt/easypatch/easypatch-agent unenroll --reason "Agent uninstalled" >/dev/null || true
    fi
fi

exit 0
