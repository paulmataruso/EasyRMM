<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>EasyPatch Agent (experimental)</title>
    <pkg-ref id="com.dhitechnical.easypatch.agent">
        <bundle-version/>
    </pkg-ref>
    <options customize="never" require-scripts="false" hostArchitectures="@HOSTARCH@"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="14.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="com.dhitechnical.easypatch.agent"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.dhitechnical.easypatch.agent" visible="false">
        <pkg-ref id="com.dhitechnical.easypatch.agent"/>
    </choice>
    <pkg-ref id="com.dhitechnical.easypatch.agent" version="@VERSION@" onConclusion="none" installKBytes="@KBYTES@">#easypatch-agent.pkg</pkg-ref>
    <product id="com.dhitechnical.easypatch.agent" version="@VERSION@"/>
</installer-gui-script>
