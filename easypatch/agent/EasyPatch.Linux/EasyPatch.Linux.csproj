<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EasyPatch.Linux</RootNamespace>
    <Description>Linux platform services for the EasyPatch agent: apt and dnf patching, inventory, restarts, key protection.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EasyPatch.Agent.Core\EasyPatch.Agent.Core.csproj" />
    <ProjectReference Include="..\EasyPatch.Unix\EasyPatch.Unix.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="EasyPatch.Unix" />
    <Using Include="EasyPatch.Unix.Processes" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EasyPatch.Agent.Tests" />
  </ItemGroup>
</Project>
