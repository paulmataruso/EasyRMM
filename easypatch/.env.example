# Copy to .env (scripts/init-secrets.sh does this) and edit. .env is ignored by git; it holds no passwords.

# Public DNS name of this server. Agents and browsers connect to https://<EASYPATCH_DOMAIN>.
# Ports 80 and 443 must be reachable from the internet for automatic certificates.
EASYPATCH_DOMAIN=patch.example.com

# Contact address for the ACME certificate authority (expiry notices).
ACME_EMAIL=admin@example.com

# EasyPatch release to run: the tag of the ghcr.io/paulmataruso/easypatch-server and easypatch-proxy images.
# Images you build yourself (docker compose build) get this tag too.
EASYPATCH_VERSION=1.10.0

# Optional: override the public URL used in install commands and links (defaults to https://EASYPATCH_DOMAIN).
# EASYPATCH_PUBLIC_URL=https://patch.example.com

# Optional: subnet of the internal "edge" network between Caddy and the API. Change it only if it collides
# with a network on the host. The API trusts X-Forwarded-For only from this subnet.
# EASYPATCH_EDGE_SUBNET=172.30.0.0/24
