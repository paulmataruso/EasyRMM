<Project>
  <!-- Central, pinned package versions. All packages are OSI-licensed (MIT / Apache-2.0 / ISC / PostgreSQL). -->
  <ItemGroup>
    <!-- Server -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
    <!-- Notifications (SMTP). MimeKit and BouncyCastle are pinned explicitly (transitive dependencies of MailKit). -->
    <PackageVersion Include="MailKit" Version="5.0.0" />
    <PackageVersion Include="MimeKit" Version="5.0.0" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- Monthly PDF reports. 6.2.x is the last MIT-licensed line (6.5.0 and later are AGPL-3.0). PDFsharp and
         System.Security.Cryptography.Pkcs are pinned explicitly (transitive dependencies). -->
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <!-- Agent -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageVersion Include="System.Management" Version="10.0.15" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
  </ItemGroup>
</Project>
