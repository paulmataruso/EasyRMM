# Site definition shared by Caddyfile (public ACME certificates) and Caddyfile.dev (Caddy's internal CA).
(easypatch) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
		-Via
	}

	# Strict CSP for the console. Swagger UI (/api/docs) ships inline bootstrap code, so it alone gets a relaxed policy;
	# it is only reachable by signed-in administrators.
	@docs path /api/docs /api/docs/*
	@app not path /api/docs /api/docs/*
	header @app Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
	header @docs Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"

	@backend path /api/* /downloads/* /health/*
	handle @backend {
		request_body {
			max_size 20MB
		}
		# Caddy replaces any client-supplied X-Forwarded-For with the real client address; the API trusts that header
		# only from the edge network (ForwardedHeaders:KnownNetworks).
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# The single sign-on callback URL carries the provider's one-time authorization code and state: keep them out of the log.
	log {
		output stdout
		format filter {
			request>uri query {
				replace code REDACTED
				replace state REDACTED
			}
			wrap json
		}
	}
}
